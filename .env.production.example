# Copy to .env.production on the VM. Never commit the real file.
SECRET_KEY=generate-a-long-random-value
ALLOWED_HOSTS=timeout.ozankaya.net
CSRF_TRUSTED_ORIGINS=https://timeout.ozankaya.net
SITE_DOMAIN=timeout.ozankaya.net
SITE_NAME=Timeout
# Password for the private johndoe admin account. Only read when demo data is first seeded.
SEED_SUPERUSER_PASSWORD=generate-a-different-long-random-value

# Optional. Leave unset to disable these features.
# OPENAI_API_KEY=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
